# Copy to .env or .dev.vars for local Wrangler development. Never commit real secrets.
RESEND_API_KEY=
RESEND_FROM="Folk Calm <guide@folkcalm.com>"

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set at least one payee check. Setting both is stricter.
PAYPAL_MERCHANT_ID=
PAYPAL_PAYEE_EMAIL=

# Use a separate, high-entropy value in production. If omitted, the code falls
# back to PAYPAL_CLIENT_SECRET for legacy compatibility.
PDF_TOKEN_SECRET=

# Canonical origin used when the payment function creates signed download URLs.
PUBLIC_SITE_URL=https://www.folkcalm.com
